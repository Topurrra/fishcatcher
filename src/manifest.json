{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Fish Catcher",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16-idle.png",
      "32": "icons/icon32-idle.png"
    }
  },
  "side_panel": { "default_path": "panel/panel.html" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs", "activeTab", "sidePanel", "contextMenus", "alarms"],
  "optional_permissions": [
    "downloads",
    "notifications",
    "https://rdap.org/*",
    "https://rdap.verisign.com/*",
    "https://raw.githubusercontent.com/*",
    "https://safebrowsing.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["probe.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_locales/*/messages.json"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "open_panel": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Open the FishCatcher panel"
    }
  }
}
